{
  "name": "meetup-raffle",
  "version": "0.0.0-semantically-released",
  "description": "Draw raffle winners at your Meetup event.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "author": {
    "name": "Justin Hall",
    "email": "justin.r.hall@gmail.com"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wKovacs64/meetup-raffle.git"
  },
  "bugs": {
    "url": "https://github.com/wKovacs64/meetup-raffle/issues"
  },
  "prettier": "@wkovacs64/prettier-config",
  "msw": {
    "workerDirectory": "public"
  },
  "scripts": {
    "clean": "rimraf .cache .netlify/functions-internal build node_modules/.vite public/sw.js",
    "build": "run-s build:*",
    "build:rr": "react-router build && node netlify/prepare.js",
    "build:sw": "esbuild app/entry.worker.ts --minify --platform=browser --format=esm --outfile=build/client/sw.js",
    "dev": "npm run clean && run-p dev:*",
    "dev:rr": "cross-env NODE_ENV=\"development\" NODE_OPTIONS=\"--require tsx/cjs --require ./mocks/index.ts\" node ./dev-server.js",
    "dev:sw": "esbuild app/entry.worker.ts --watch --platform=browser --format=esm --outfile=public/sw.js",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "netlify serve",
    "typecheck": "react-router typegen && tsc",
    "validate": "run-p format:check lint typecheck"
  },
  "dependencies": {
    "@faker-js/faker": "9.8.0",
    "@netlify/functions": "3.1.9",
    "@react-router/node": "7.6.1",
    "@zag-js/number-input": "1.12.4",
    "@zag-js/react": "1.12.4",
    "isbot": "5.1.28",
    "meetup-randomizer": "3.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router": "7.6.1",
    "zod": "3.25.28"
  },
  "devDependencies": {
    "@mjackson/node-fetch-server": "0.6.1",
    "@react-router/dev": "7.6.1",
    "@react-router/fs-routes": "7.6.1",
    "@tailwindcss/vite": "4.1.7",
    "@types/express": "5.0.2",
    "@types/react": "19.1.5",
    "@types/react-dom": "19.1.5",
    "@wkovacs64/eslint-config": "7.5.2",
    "@wkovacs64/prettier-config": "4.1.1",
    "cpy-cli": "5.0.0",
    "cross-env": "7.0.3",
    "esbuild": "0.25.4",
    "eslint": "9.27.0",
    "express": "5.1.0",
    "glob": "11.0.2",
    "msw": "2.8.4",
    "netlify-cli": "21.5.0",
    "npm-run-all2": "8.0.3",
    "postcss-import": "16.1.0",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.11",
    "rimraf": "6.0.1",
    "semantic-release": "24.2.5",
    "tailwindcss": "4.1.7",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-static-copy": "3.0.0",
    "vite-tsconfig-paths": "5.1.4"
  },
  "overrides": {
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
