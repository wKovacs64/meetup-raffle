{
  "name": "meetup-raffle",
  "version": "0.0.0-semantically-released",
  "description": "Draw raffle winners at your Meetup event.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "author": {
    "name": "Justin Hall",
    "email": "justin.r.hall@gmail.com"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wKovacs64/meetup-raffle.git"
  },
  "bugs": {
    "url": "https://github.com/wKovacs64/meetup-raffle/issues"
  },
  "prettier": "@wkovacs64/prettier-config",
  "msw": {
    "workerDirectory": "public"
  },
  "scripts": {
    "clean": "rimraf .cache .netlify/functions-internal build node_modules/.vite public/sw.js",
    "build": "run-s build:*",
    "build:rr": "react-router build && node netlify/prepare.js",
    "build:sw": "esbuild app/entry.worker.ts --minify --platform=browser --format=esm --outfile=build/client/sw.js",
    "dev": "npm run clean && run-p dev:*",
    "dev:rr": "cross-env NODE_ENV=\"development\" NODE_OPTIONS=\"--require tsx/cjs --require ./mocks/index.ts\" node ./dev-server.js",
    "dev:sw": "esbuild app/entry.worker.ts --watch --platform=browser --format=esm --outfile=public/sw.js",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "netlify serve",
    "typecheck": "react-router typegen && tsc",
    "validate": "run-p format:check lint typecheck"
  },
  "dependencies": {
    "@faker-js/faker": "10.0.0",
    "@netlify/functions": "4.2.5",
    "@react-router/node": "7.8.2",
    "@zag-js/number-input": "1.22.1",
    "@zag-js/react": "1.22.1",
    "isbot": "5.1.30",
    "meetup-randomizer": "3.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router": "7.8.2",
    "zod": "4.1.7"
  },
  "devDependencies": {
    "@mjackson/node-fetch-server": "0.7.0",
    "@react-router/dev": "7.8.2",
    "@react-router/fs-routes": "7.8.2",
    "@tailwindcss/vite": "4.1.13",
    "@types/express": "5.0.3",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@wkovacs64/eslint-config": "7.9.1",
    "@wkovacs64/prettier-config": "4.2.1",
    "cpy-cli": "6.0.0",
    "cross-env": "10.0.0",
    "esbuild": "0.25.9",
    "eslint": "9.35.0",
    "express": "5.1.0",
    "glob": "11.0.3",
    "msw": "2.11.2",
    "netlify-cli": "23.5.1",
    "npm-run-all2": "8.0.4",
    "postcss-import": "16.1.1",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "rimraf": "6.0.1",
    "semantic-release": "24.2.8",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vite-plugin-static-copy": "3.1.2",
    "vite-tsconfig-paths": "5.1.4"
  },
  "overrides": {
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
